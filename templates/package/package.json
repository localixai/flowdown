{
  "name": "@localix-ai/{{name}}",
  "version": "0.0.0",
  "description": "{{description}}",
  "keywords": [
    "agent",
    "ai",
    "llm",
    "streaming",
    "zero-dependency"
  ],
  "homepage": "https://github.com/localixai/flowdown/tree/main/packages/{{name}}",
  "bugs": {
    "url": "https://github.com/localixai/flowdown/issues"
  },
  "license": "MIT",
  "author": "rsaryev (https://github.com/rsaryev)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/localixai/flowdown.git",
    "directory": "packages/{{name}}"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "test": "bun test --randomize",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check": "publint --strict && attw --pack . --profile esm-only",
    "size": "bun scripts/size.ts",
    "bench": "bun bench/run.ts --check"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@types/bun": "1.4.3",
    "publint": "0.3.25",
    "tsdown": "0.23.7",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=20"
  }
}
