{
  "name": "llx-markdown-site",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --cwd ../../packages/llx-markdown build && vite",
    "build": "bun run --cwd ../../packages/llx-markdown build && vite build && vite build --ssr src/entry-server.tsx --outDir dist-server && bun scripts/prerender.ts",
    "preview": "vite preview",
    "test": "bun test",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "katex": "0.19.1",
    "llx-markdown": "workspace:*",
    "mermaid": "12.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/bun": "1.4.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.7"
  }
}
