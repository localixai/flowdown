{
  "name": "llx-markdown-monorepo",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*",
    "examples/*"
  ],
  "type": "module",
  "scripts": {
    "build": "bun run --cwd packages/llx-markdown build",
    "test": "bun run --cwd packages/llx-markdown test",
    "typecheck": "bun run --cwd packages/llx-markdown typecheck",
    "lint": "oxlint packages apps examples",
    "format": "oxfmt packages apps examples",
    "format:check": "oxfmt --check packages apps examples",
    "check": "bun run --cwd packages/llx-markdown check",
    "changeset": "changeset",
    "version": "changeset version && bun install",
    "release": "bun run build && bun run check && changeset publish",
    "site": "bun run --cwd apps/site dev",
    "site:build": "bun run --cwd apps/site build"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0"
  },
  "packageManager": "bun@1.4.4"
}
