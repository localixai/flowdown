{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // A renderer for pages: the DOM's types and React's JSX on top of the shared base.
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    // The repository's own packages, read from their source: a test, the types and the build take
    // them as they are, with no build of them first.
    "paths": { "@localix-ai/highlight": ["../highlight/src/index.ts"] }
  },
  "include": ["src", "scripts", "test"]
}
