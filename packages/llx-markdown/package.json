{
  "name": "llx-markdown",
  "version": "0.0.0",
  "description": "Markdown for AI replies and docs in React: GitHub Markdown plus steps, tabs, stats, pros and cons, callouts, file trees, diagrams and math, rendered while it streams.",
  "keywords": [
    "ai",
    "callouts",
    "katex",
    "llm",
    "markdown",
    "mermaid",
    "react",
    "react-markdown",
    "remark",
    "steps",
    "streaming",
    "tabs"
  ],
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./remark": "./dist/remark.js",
    "./stream": "./dist/stream.js",
    "./prompt": "./dist/prompt/index.js",
    "./math": "./dist/math/index.js",
    "./highlight": "./dist/highlight/index.js",
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown && bun scripts/build-css.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check": "publint --strict && attw --pack . --profile esm-only --exclude-entrypoints styles.css && bun scripts/check-package.ts",
    "size": "bun scripts/size.ts"
  },
  "dependencies": {
    "@types/hast": "^3.0.4",
    "@types/mdast": "^4.0.4",
    "@types/unist": "^3.0.3",
    "hast-util-from-html-isomorphic": "^2.0.0",
    "marked": "^18.1.3",
    "mdast-util-to-string": "^4.0.0",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@happy-dom/global-registrator": "21.0.4",
    "@types/bun": "1.4.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "highlight.js": "11.12.0",
    "katex": "0.19.1",
    "mermaid": "12.3.0",
    "publint": "0.3.25",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsdown": "0.23.7",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "highlight.js": "^11.0.0",
    "katex": ">=0.16.0",
    "react": "^18.2.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "highlight.js": {
      "optional": true
    },
    "katex": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20"
  }
}
