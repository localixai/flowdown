{
  "name": "@localix-ai/math",
  "version": "0.1.1",
  "description": "TeX formulas for pages and terminals as agents write them: MathML a browser lays out itself, with its own small math font, and the same formula on rows of a terminal. Any prefix of a stream draws; no dependencies.",
  "keywords": [
    "agent",
    "ai",
    "katex-alternative",
    "latex",
    "llm",
    "math",
    "mathml",
    "streaming",
    "terminal",
    "tex",
    "zero-dependency"
  ],
  "homepage": "https://github.com/localixai/flowdown/tree/main/packages/math",
  "bugs": {
    "url": "https://github.com/localixai/flowdown/issues"
  },
  "license": "MIT",
  "author": "rsaryev (https://github.com/rsaryev)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/localixai/flowdown.git",
    "directory": "packages/math"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./styles.css": "./dist/styles.css",
    "./math.woff2": "./dist/math.woff2",
    "./math-letters.woff2": "./dist/math-letters.woff2",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown && cp src/styles.css fonts/math.woff2 fonts/math-letters.woff2 fonts/OFL.txt dist/",
    "test": "bun test --randomize",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check": "publint --strict && attw --pack . --profile esm-only --exclude-entrypoints styles.css math.woff2 math-letters.woff2",
    "size": "bun scripts/size.ts",
    "bench": "bun bench/run.ts --check",
    "shots": "bun scripts/shots.ts",
    "font": "bun scripts/font.ts"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@fontsource/stix-two-math": "5.3.0",
    "@types/bun": "1.4.3",
    "katex": "0.16.22",
    "playwright-core": "1.64.1",
    "publint": "0.3.25",
    "temml": "0.11.11",
    "tsdown": "0.23.7",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=20"
  }
}
