{
  "name": "flowdown-demo",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun src/serve.ts",
    "review": "bun run --cwd ../packages/flowdown build && bun src/review.ts",
    "shots": "bun run --cwd ../packages/flowdown build && bun src/capture.ts"
  },
  "dependencies": {
    "@localix-ai/flowdown": "workspace:*",
    "highlight.js": "11.12.0",
    "katex": "0.19.1",
    "mermaid": "12.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/bun": "1.4.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "playwright-core": "1.64.1"
  }
}
