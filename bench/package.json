{
  "name": "flowdown-bench",
  "private": true,
  "type": "module",
  "scripts": {
    "bench": "bun run --cwd ../packages/flowdown build && NODE_ENV=production bun src/run.ts",
    "bench:quick": "NODE_ENV=production bun src/run.ts --quick",
    "bench:check": "bun src/check.ts",
    "browser": "bun run --cwd ../packages/flowdown build && bun src/browser.ts",
    "parse": "bun src/parse.ts",
    "size": "bun src/size.ts",
    "features": "NODE_ENV=production bun src/features.tsx",
    "deps": "bun src/install.ts",
    "charts": "bun src/charts.ts"
  },
  "dependencies": {
    "@happy-dom/global-registrator": "21.0.4",
    "commonmark-spec": "0.31.2",
    "highlight.js": "11.11.1",
    "@localix-ai/flowdown": "workspace:*",
    "markdown-it": "15.0.3",
    "markdown-it-footnote": "4.0.0",
    "markdown-it-task-lists": "2.1.1",
    "markdown-to-jsx": "9.10.6",
    "marked": "18.1.3",
    "marked-react": "4.0.0",
    "markstream-react": "2.0.24",
    "mdast-util-from-markdown": "2.1.0",
    "mdast-util-gfm": "3.1.0",
    "micromark": "4.0.3",
    "micromark-extension-gfm": "3.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "streamdown": "2.7.1"
  },
  "devDependencies": {
    "playwright-core": "1.64.1"
  }
}
