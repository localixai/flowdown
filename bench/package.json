    "bench:check": "bun src/check.ts"
  },
  "dependencies": {
    "@happy-dom/global-registrator": "21.0.4",
    "llx-markdown": "workspace:*",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "streamdown": "2.7.1",
    "highlight.js": "11.11.1"
  }
}
